{
  "name": "saeed-renderer-lab",
  "version": "0.3.2",
  "private": true,
  "description": "Saeed 3D Renderer Comparison Lab",
  "main": "main.js",
  "scripts": {
    "bundle": "esbuild renderer.js --bundle --format=esm --platform=browser --outfile=renderer.bundle.js",
    "dist": "npm run bundle && electron-builder --win portable"
  },
  "dependencies": {"three": "0.180.0"},
  "devDependencies": {"electron": "44.4.4", "electron-builder": "26.0.12", "esbuild": "0.25.9"},
  "build": {
    "appId": "com.saeed.renderlab",
    "productName": "Saeed Renderer Lab",
    "artifactName": "Saeed-Renderer-Lab-${version}-${arch}.${ext}",
    "asar": true,
    "files": ["main.js","index.html","renderer.js","renderer.bundle.js","style.css","saeed.ai.glb"],
    "extraResources": [{"from":"native","to":"native"},{"from":"shaders","to":"shaders"}],
    "win": {"target":[{"target":"portable","arch":["x64"]}]}
  }
}